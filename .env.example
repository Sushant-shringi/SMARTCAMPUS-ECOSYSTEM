# =============================================================================
# SMARTCAMPUS ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Global Environment
ENVIRONMENT=development
DEBUG=True

# Attendance Service (FastAPI)
ATTENDANCE_PORT=8000
ATTENDANCE_DATABASE_URL=sqlite:///./smartattend.db
JWT_SECRET=replace_with_a_secure_random_64_char_key_for_production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Career & Placement AI Service (FastAPI + ChromaDB + GenAI)
CAREER_PORT=8001
LLM_PROVIDER=gemini # 'gemini' or 'ollama'
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Institutional Attendance Gate Policy
MINIMUM_ATTENDANCE_PLACEMENT_THRESHOLD=75.0

# Unified Web Portal
VITE_ATTENDANCE_API_URL=http://localhost:8000/api/v1
VITE_CAREER_API_URL=http://localhost:8001/api
