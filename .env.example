# =============================================================================
# SMARTCAMPUS ECOSYSTEM - ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Global Environment: 'development' | 'production' | 'staging'
ENVIRONMENT=development
DEBUG=True

# -----------------------------------------------------------------------------
# Security & JWT Configuration
# In production (ENVIRONMENT=production):
# - JWT_SECRET and REFRESH_SECRET_KEY must be >= 32 characters.
# - Key cannot use placeholder strings ("super-secret", "default", "change-in-production").
# - Startup will FAIL FAST with ValueError if insecure keys are supplied.
# Generate strong keys with: openssl rand -hex 32
# -----------------------------------------------------------------------------
JWT_SECRET=super-secret-smartattend-key-change-in-production-long-random-string
REFRESH_SECRET_KEY=super-secret-refresh-key-change-in-production-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Explicit CORS Whitelist (comma-separated list of allowed origins)
# Wildcards ("*") are strictly rejected in production when credentials are true.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# -----------------------------------------------------------------------------
# Attendance Service (FastAPI - Port 8000)
# -----------------------------------------------------------------------------
ATTENDANCE_PORT=8000
# For local dev: sqlite:///./smartattend.db
# For Docker: sqlite:////app/data/smartattend.db
# For Cloud PostgreSQL: postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL=sqlite:///./smartattend.db

# Proximity Attendance Policy
DEFAULT_RSSI_THRESHOLD=-85
DEFAULT_LATE_THRESHOLD_MINUTES=5
DEFAULT_SESSION_DURATION_MINUTES=50
MAX_FUTURE_TIME_SKEW_SECONDS=180
# CRITICAL: DEMO_ATTENDANCE_MODE MUST be false in production (enforced at startup)
DEMO_ATTENDANCE_MODE=false

# -----------------------------------------------------------------------------
# Career & Placement AI Service (FastAPI + ChromaDB + GenAI - Port 8001)
# -----------------------------------------------------------------------------
CAREER_PORT=8001
ATTENDANCE_SERVICE_URL=http://localhost:8000
ATTENDANCE_DATABASE_URL=sqlite:///./services/attendance-service/smartattend.db

# LLM Provider Configuration ('gemini' or 'ollama')
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Institutional Attendance Gate Policy (Authoritative Minimum Percentage)
MINIMUM_ATTENDANCE_PLACEMENT_THRESHOLD=75.0

# -----------------------------------------------------------------------------
# Unified Web Portal (React 19 + Vite + Tailwind CSS - Port 5173)
# -----------------------------------------------------------------------------
VITE_ATTENDANCE_API_URL=http://localhost:8000/api/v1
VITE_CAREER_API_URL=http://localhost:8001/api
